# 测试内网或本机 HTTPS 时用 selfsigned；公网真实签发时改成 letsencrypt。
MODE=selfsigned

# MODE=letsencrypt 时必填：公网 IPv4 或 IPv6，必须直接访问到这台机器的 80/443 端口。
PUBLIC_IP=203.0.113.10

# 建议填写，用于 Let's Encrypt 重要通知。
ACME_EMAIL=admin@example.com

# MODE=letsencrypt 时，先用 1 测试。确认日志显示签发成功后，改为 0 申请正式受信任证书。
LETSENCRYPT_STAGING=1

# IP 证书是 shortlived profile，有效期约 160 小时；这里默认每 6 小时检查一次续签。
RENEW_INTERVAL_SECONDS=21600

# IP 访问场景保持默认即可。
SERVER_NAME=_

# 可选：HTTP 反向代理匹配路径前缀（如 / 或 /etf），默认为 /
PROXY_LOCATION=/

# 可选：HTTP 反向代理目标服务（如 http://101.200.183.179 或 http://127.0.0.1:8080）。
# 未设置时默认提供静态 index.html 页面；设置后指定路径（如 /etf）的请求将被转发给该后端服务，同时保留 /downloads/ 文件下载功能。
PROXY_PASS=


