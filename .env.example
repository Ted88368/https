# 测试内网或本机 HTTPS 时用 selfsigned；公网真实签发时改成 letsencrypt。
MODE=selfsigned

# 公网 IPv4 或 IPv6 地址。
# 若同时配置了域名且 SIGN_IP=auto/1，证书将同时包含 IP 与域名 SAN。
PUBLIC_IP=203.0.113.10

# 域名配置：支持空格或逗号分隔多个域名（例如 www.justetf.top justetf.top）。
# 也可直接在 SERVER_NAME 中写域名。
DOMAINS=

# Nginx 的 server_name 配置。若包含有效域名（如 www.justetf.top），系统会自动将其加入证书签发列表。
# 纯 IP 访问场景保持默认 "_" 即可。
SERVER_NAME=_

# 是否在证书中包含 PUBLIC_IP（IP SAN）：
# - auto（默认）：若 PUBLIC_IP 为公网 IP 则包含（使用 shortlived profile，6天有效期，自动续签）。
# - 0 / false：仅签发域名证书（标准 90 天有效期）。
SIGN_IP=auto

# 建议填写，用于 Let's Encrypt 重要通知。
ACME_EMAIL=admin@example.com

# MODE=letsencrypt 时，先用 1 测试。确认日志显示签发成功后，改为 0 申请正式受信任证书。
LETSENCRYPT_STAGING=1

# 自动续签检查间隔，默认 21600 秒（6 小时）。
RENEW_INTERVAL_SECONDS=21600
