# 自定义多服务路径代理示例配置文件
# 默认模板已内置启用 /api/ (8000) 和 /admin/ (8002) 代理。
# 如需扩展其他自定义服务，复制此文件为 <service-name>.conf (例如 locations.d/custom.conf) 即可生效。
#
# 注意 proxy_pass 末尾是否有斜杠 /：
# 1. proxy_pass http://host.docker.internal:8003/;  (带 /)
#    访问 https://<IP>/custom/users -> 转发为 http://host.docker.internal:8003/users (去除 /custom 前缀)
# 2. proxy_pass http://host.docker.internal:8003;   (不带 /)
#    访问 https://<IP>/custom/users -> 转发为 http://host.docker.internal:8003/custom/users (保留 /custom 前缀)

# === 自定义扩展服务示例 (代理到宿主机 8003 端口) ===
# location /custom/ {
#     proxy_pass http://host.docker.internal:8003/;
#     proxy_http_version 1.1;
#
#     # 常用代理头配置
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#
#     # 支持 WebSocket
#     proxy_set_header Upgrade $http_upgrade;
#     proxy_set_header Connection $connection_upgrade;
#
#     # 超时与缓存设置 (可根据需要调整)
#     proxy_connect_timeout 60s;
#     proxy_read_timeout 60s;
#     proxy_send_timeout 60s;
# }
