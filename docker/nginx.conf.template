map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root ${WEBROOT};
        default_type text/plain;
    }

    # 80 端口根路由一律跳转 HTTPS（不再反代面板）
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate ${LIVE_FULLCHAIN};
    ssl_certificate_key ${LIVE_PRIVKEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;

    location /downloads/ {
        alias /usr/share/nginx/html/downloads/;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
        charset utf-8;
    }

    # 引入多服务模块化 location 路由规则（自定义扩展）
    include /etc/nginx/conf.d/locations/*.conf;

    # 下载目录不带结尾斜杠时，重定向到带斜杠的路径（避免落到根反代导致 503）
    location = /downloads {
        return 301 /downloads/;
    }

    # 兼容 /download（单数，少 s）写法，重定向到 /downloads（复数），并保留子路径
    location ~ ^/download(/.*)?$ {
        return 301 /downloads$1;
    }

    # 默认根路由：直接提供静态站点（日历 / index.html），不再反代到面板
    location / {
        try_files $uri $uri/ /index.html;
    }
}
